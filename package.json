{
  "name": "woodcutapp",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "dependencies": {
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@tanstack/react-router": "^1.0.0",
    "@woodcutapp/wasm": "^0.1.1",
    "@woodcutapp/woodcutapp": "^0.2.0",
    "i18next": "^26.0.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-http-backend": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@rolldown/plugin-babel": "^0.2.0",
    "@stylistic/eslint-plugin": "^5.0.0",
    "@tanstack/router-devtools": "^1.0.0",
    "@tanstack/router-plugin": "^1.0.0",
    "@types/eslint__js": "^8.0.0",
    "@types/gtag.js": "^0.0.20",
    "@types/node": "^25.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.0.0",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "jiti": "^2.0.0",
    "ts-json-schema-generator": "^2.3.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0",
    "typescript-json-schema": "^0.67.0",
    "vite": "^8.0.0",
    "vite-plugin-wasm": "^3.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "fix": "eslint . --fix",
    "lang": "npm run lang:app-menu && npm run lang:common && npm run lang:feature && npm run lang:home && npm run lang:navigation && npm run lang:project",
    "lang:app-menu": "npx ts-json-schema-generator -p src/i18n/schema.ts -t AppMenuJsonSchema -f tsconfig.app.json  > ./public/lang/schema/app-menu.json",
    "lang:common": "npx ts-json-schema-generator -p src/i18n/schema.ts -t CommonJsonSchema -f tsconfig.app.json  > ./public/lang/schema/common.json",
    "lang:feature": "npx ts-json-schema-generator -p src/i18n/schema.ts -t FeatureJsonSchema -f tsconfig.app.json  > ./public/lang/schema/feature.json",
    "lang:home": "npx ts-json-schema-generator -p src/i18n/schema.ts -t HomeJsonSchema -f tsconfig.app.json  > ./public/lang/schema/home.json",
    "lang:navigation": "npx ts-json-schema-generator -p src/i18n/schema.ts -t NavigationJsonSchema -f tsconfig.app.json  > ./public/lang/schema/navigation.json",
    "lang:project": "npx ts-json-schema-generator -p src/i18n/schema.ts -t ProjectJsonSchema -f tsconfig.app.json  > ./public/lang/schema/project.json",
    "lint": "eslint .",
    "preview": "vite preview"
  }
}
